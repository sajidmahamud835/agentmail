# Copy to .env. The installer generates blank secrets once and preserves them.
MAIL_HOSTNAME=mail.example.com
ACME_EMAIL=admin@example.com
PUBLIC_IPV4=203.0.113.10
DB_ROOT_PASSWORD=
DB_POSTAL_PASSWORD=
RAILS_SECRET_KEY=
# Enabled automatically after the HTTPS certificate is copied for SMTP.
SMTP_TLS_ENABLED=false
# Optional Postal administrative email credentials; configure after first login.
ADMIN_SMTP_USERNAME=
ADMIN_SMTP_PASSWORD=
ADMIN_FROM_ADDRESS=admin@example.com
